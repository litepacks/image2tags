{
  "compilerOptions": {
    "target": "ES2017",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "tests", "dist"]
} 